# ==============================================================================
# OpenRouter / OpenAI API Configuration
# Người dùng điền OPENAI_API_KEY từ OpenRouter (e.g. sk-or-v1-...)
# ==============================================================================
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
# Mô hình QA thực nghiệm: claude-opus-4.6 (hoặc openai/gpt-4o-mini, qwen/qwen-2.5-vl-72b-instruct)
QA_MODEL=claude-opus-4.6
VISION_MODEL=claude-opus-4.6

# ==============================================================================
# Embedding Endpoints Configuration
# ==============================================================================
# Jina v5 Omni Nano (Triton GPU Gateway)
EMBED_API_KEY=your_embed_api_key_here
EMBED_API_URL=http://localhost:8036/v1

# BGE-M3 Remote Embedding Gateway
BGE3_API_URL=http://localhost:8080/v1/embeddings
BGE3_MODEL=BAAI/bge-m3
